# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local demo note store (server-side, single shared wallet)
/.data

# typescript
*.tsbuildinfo
next-env.d.ts

# committee key: read from ATRUM_CORE_DIR at runtime, never copied here.
# atrum-core gitignores it too -- a second home is a second thing to drift.
src/server/atrum/committee-key.json
