# Copy to `.env.local` (gitignored) and fill in.

# Where compiled circuit artefacts live. Defaults to ./circuits-build (committed to this
# repo -- see scripts/sync-circuits.mjs), so this rarely needs setting. Whatever it points
# to must be the same tree the live pool's verifiers were deployed from -- a mismatch fails
# as InvalidProof() with no other diagnostic.
# CIRCUITS_DIR=./circuits-build

# The committee's ElGamal decryption key, as JSON: {"pubKey":["...","..."],"secret":"..."}.
# Falls back to CIRCUITS_DIR/committee-key.json for local dev if unset (gitignored there --
# never commit a real one). Required in any deployed environment: there's no writable,
# non-committed place to put a secret file on Vercel.
COMMITTEE_KEY_JSON=

# Postgres connection string for note storage and single-use sign-in nonces (Vercel
# Postgres, Neon, Supabase -- anything the `pg` package can connect to). Run
# `npm run db:migrate` once against it before first use.
DATABASE_URL=postgres://...

# The live deployment. See atrum-core/deployments/monad-testnet-10143/README.md.
POOL_ADDRESS=0x...
COLLATERAL_ADDRESS=0x...

# Server-side RPC. Prefer a private endpoint: the public one intermittently reports
# "Signer had insufficient balance" against a well-funded account under load
# (atrum-core/sequencer/src/chains.ts documents the measurement).
RPC_URL=https://...

# Public RPC handed to the BROWSER. Never the private one -- it carries an API key.
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# WalletConnect (Reown Cloud) project id, from https://cloud.reown.com. Public by design --
# it identifies the dapp to the relay, it is not a secret. Wallet connection does not work
# at all without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# The sequencer: serves Merkle paths and relays proof-gated actions. Base URL only --
# sequencerClient.ts appends /path, /health etc itself.
SEQUENCER_URL=https://atrum-core.onrender.com

# Operator key. Used ONLY for `Vault.resolve` and `publishFinalTotals` on manually-resolved
# demo markets. User actions never touch it: deposits are signed by the user's own wallet and
# bet/redeem/withdraw go out through the sequencer's relayer. Use a THROWAWAY key.
PRIVATE_KEY=0x...

# HMAC key for session cookies. Generate with `head -c 32 /dev/urandom | base64`.
# There is deliberately no default: a fallback secret is how a forgeable session cookie
# reaches production, and the failure would be silent.
SESSION_SECRET=

# HMAC key for the testnet access-gate cookie (src/server/atrum/gate.ts). Generate the
# same way as SESSION_SECRET, but use a DIFFERENT value -- these protect conceptually
# different things (wallet session vs. testnet entry), so a leak/rotation of one
# shouldn't touch the other.
GATE_SECRET=

# Base origin of the atrum-landing deployment (waitlist owner), e.g. https://atrum.fun
# in prod or http://localhost:3001 locally. /api/atrum/gate appends
# /api/internal/access-code/validate itself.
ATRUM_LANDING_URL=http://localhost:3001

# Shared secret authenticating the server-to-server call to atrum-landing's access-code
# validate endpoint. Must be the EXACT SAME value as atrum-landing's
# GATE_VALIDATION_SHARED_SECRET -- one secret, copied into both repos.
GATE_VALIDATION_SHARED_SECRET=

# Client-side proving is ON by default. Set to 0 to force the old server-proving path, where
# the server builds the witness and therefore sees every note secret. Inlined at build time,
# so changing it requires a redeploy either way.
NEXT_PUBLIC_CLIENT_PROVING=1
