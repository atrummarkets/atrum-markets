# @reown/appkit-adapter-wagmi requires wagmi 3.x, whose transitive `accounts` -> privy ->
# permissionless chain declares a conflicting optional peer on ox. The conflict is between
# optional peers of packages this app never loads (Base Account / x402 payments), so strict
# peer resolution fails on a tree that works. CI installs must resolve the same way this
# lockfile was built, or the deploy install fails where local install succeeded.
legacy-peer-deps=true
